#!/usr/bin/env bash
#
# clodex — launch an unmodified Claude Code that is routed to your ChatGPT/
# Codex subscription instead of the Anthropic API.
#
# It does NOT patch or touch the Claude Code binary. It only:
#   1. makes sure a local Anthropic->Codex translation proxy is running
#      (auto-started once, then reused across sessions), and
#   2. execs the real `claude` binary with a handful of env vars that exist
#      *only* for that child process.
#
# Running plain `claude` in another terminal is completely unaffected: it sees
# none of these variables and keeps talking to Anthropic. Both commands use
# Claude Code's normal configuration, so settings, plugins, and sessions remain
# shared.
#
set -euo pipefail

# --- configuration (override any of these via the environment) -------------
: "${CLODEX_PROXY_BIN:=clodex-proxy}"
: "${CLODEX_HOST:=127.0.0.1}"
: "${CLODEX_PORT:=18765}"
# CLODEX_MODEL is intentionally EMPTY by default: we do NOT pin ANTHROPIC_MODEL,
# so Claude Code shows its native Opus/Sonnet/Haiku picker. Those claude ids
# resolve through the proxy to Codex tiers (opus->sol, sonnet->terra, haiku->luna).
# Pinning a raw gpt-* id instead would collapse the picker to a single "Custom
# model". Set CLODEX_MODEL to pin one anyway (e.g. claude-fable-5, gpt-5.6-luna).
: "${CLODEX_MODEL:=}"
# The small/fast (background + subagent-haiku) model DOES need a resolvable id,
# or those requests 400. claude-haiku-4-5 -> gpt-5.6-luna via the proxy.
: "${CLODEX_SMALL_MODEL:=claude-haiku-4-5}"
# Per-tier ids behind the picker rows. The "[1m]" suffix is what makes Claude
# Code believe the model has a 1M window on a non-Anthropic base URL (see the
# auto-compact note below); Claude Code strips it before sending, and the proxy
# strips it again as a fallback. Set one to "" to leave that tier at Claude
# Code's default (200k believed window).
: "${CLODEX_FABLE_MODEL=claude-fable-5-1[1m]}"
: "${CLODEX_OPUS_MODEL=claude-opus-5[1m]}"
: "${CLODEX_SONNET_MODEL=claude-sonnet-5[1m]}"
: "${CLODEX_CLAUDE_BIN:=/opt/claude-code/bin/claude}"
: "${CODEX_HOME:=$HOME/.codex}"
: "${CLODEX_CODEX_AUTH:=$CODEX_HOME/auth.json}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/clodex"
log_file="$state_dir/proxy.log"

die() { printf 'clodex: %s\n' "$*" >&2; exit 1; }

port_open() { (exec 3<>"/dev/tcp/$CLODEX_HOST/$CLODEX_PORT") 2>/dev/null && exec 3>&- 3<&-; }

proxy_pids() { pgrep -f "$CLODEX_PROXY_BIN serve" 2>/dev/null || true; }

start_proxy() {
    command -v "$CLODEX_PROXY_BIN" >/dev/null 2>&1 \
        || die "proxy binary '$CLODEX_PROXY_BIN' not on PATH (install the clodex package)."
    mkdir -p "$state_dir"
    # CCP_USE_CODEX_CLI_AUTH=1 makes the fork read/refresh ~/.codex/auth.json,
    # so no separate login is needed. setsid + redirects fully detach it so it
    # persists across clodex sessions.
    CCP_USE_CODEX_CLI_AUTH=1 CODEX_HOME="$CODEX_HOME" \
        setsid "$CLODEX_PROXY_BIN" serve --port "$CLODEX_PORT" \
        >>"$log_file" 2>&1 </dev/null &
    for _ in $(seq 1 100); do
        port_open && return 0
        sleep 0.1
    done
    die "proxy did not come up within 10s; see $log_file"
}

# --- optional maintenance subcommands: `clodex --proxy <cmd>` ---------------
if [ "${1:-}" = "--proxy" ]; then
    case "${2:-status}" in
        status)
            if port_open; then echo "clodex proxy: running on $CLODEX_HOST:$CLODEX_PORT (pids: $(proxy_pids | tr '\n' ' '))";
            else echo "clodex proxy: not running"; fi ;;
        stop)    pids=$(proxy_pids); [ -n "$pids" ] && kill $pids && echo "stopped: $pids" || echo "not running" ;;
        restart) pids=$(proxy_pids); [ -n "$pids" ] && kill $pids; sleep 0.3; start_proxy && echo "restarted" ;;
        log)     exec tail -n "${3:-50}" -f "$log_file" ;;
        *)       die "unknown --proxy command '${2:-}'. use: status | stop | restart | log" ;;
    esac
    exit 0
fi

# --- preflight -------------------------------------------------------------
[ -r "$CLODEX_CODEX_AUTH" ] \
    || die "no Codex credentials at $CLODEX_CODEX_AUTH — run 'codex login' first."
[ -x "$CLODEX_CLAUDE_BIN" ] \
    || die "claude binary not found at $CLODEX_CLAUDE_BIN (set CLODEX_CLAUDE_BIN)."

# --- ensure the proxy daemon is up (started once, reused thereafter) --------
port_open || start_proxy

# --- exec the untouched Claude Code, scoped to the Codex subscription -------
# These assignments live ONLY in this child process (see `env` below); they are
# never exported to your shell or to any other running claude.
#
# We rely on Claude Code's built-in Opus/Sonnet/Haiku picker (they resolve
# through the proxy), NOT gateway /v1/models discovery — so nonessential traffic
# is disabled to keep things quiet. Only pin ANTHROPIC_MODEL when the user
# explicitly set CLODEX_MODEL, otherwise leave Claude Code on its native default.
model_env=()
[ -n "${CLODEX_MODEL:-}" ] && model_env+=("ANTHROPIC_MODEL=$CLODEX_MODEL")

# Auto-compact window. The Codex backend's real ceiling for GPT-6 Astra (and
# the 5.6 family) is max_context_window = 872000 tokens of input (1M minus the
# 128k output reserve). The old 272000 was the Codex CLI's conservative default
# and made Claude Code compact at ~24% of the window; a 285k-token request was
# verified accepted live on 2026-09-14.
#
# CLAUDE_CODE_AUTO_COMPACT_WINDOW alone is NOT enough: Claude Code clamps it to
# the window it *believes* the model has, and on a non-Anthropic base URL every
# model is believed to be 200k unless its id ends in "[1m]" (the catalog says
# Fable is natively 1M, but that only counts on api.anthropic.com/Bedrock/
# Vertex). So the tier ids above carry "[1m]"; with that, `/context` reports
# 872k instead of 200k. Claude Code compacts at this value minus ~33k.
: "${CLODEX_AUTO_COMPACT_WINDOW:=872000}"

tier_env=()
[ -n "${CLODEX_FABLE_MODEL:-}" ]  && tier_env+=("ANTHROPIC_DEFAULT_FABLE_MODEL=$CLODEX_FABLE_MODEL")
[ -n "${CLODEX_OPUS_MODEL:-}" ]   && tier_env+=("ANTHROPIC_DEFAULT_OPUS_MODEL=$CLODEX_OPUS_MODEL")
[ -n "${CLODEX_SONNET_MODEL:-}" ] && tier_env+=("ANTHROPIC_DEFAULT_SONNET_MODEL=$CLODEX_SONNET_MODEL")

exec env -u ANTHROPIC_API_KEY \
    ANTHROPIC_BASE_URL="http://$CLODEX_HOST:$CLODEX_PORT" \
    ANTHROPIC_AUTH_TOKEN="clodex" \
    ANTHROPIC_SMALL_FAST_MODEL="$CLODEX_SMALL_MODEL" \
    "${model_env[@]}" \
    "${tier_env[@]}" \
    CLAUDE_CODE_ENABLE_AUTO_MODE=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1 \
    CLAUDE_CODE_AUTO_COMPACT_WINDOW="$CLODEX_AUTO_COMPACT_WINDOW" \
    DISABLE_UPDATES=1 \
    DISABLE_INSTALLATION_CHECKS=1 \
    DISABLE_AUTOUPDATER=1 \
    "$CLODEX_CLAUDE_BIN" "$@"
