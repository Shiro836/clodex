#!/usr/bin/env bash
#
# claudeep — launch an unmodified Claude Code against DeepSeek's
# Anthropic-compatible API while sharing Claude Code's normal configuration.
#
# Provider and model overrides exist only for the child process. Settings,
# plugins, MCP servers, and sessions remain in the same config used by `claude`.
#
set -euo pipefail

: "${CLAUDEEP_BASE_URL:=https://api.deepseek.com/anthropic}"
: "${CLAUDEEP_MODEL:=}"
: "${CLAUDEEP_FABLE_MODEL:=deepseek-v4-pro}"
: "${CLAUDEEP_OPUS_MODEL:=deepseek-v4-pro}"
: "${CLAUDEEP_SONNET_MODEL:=deepseek-v4-flash-vision-exp}"
: "${CLAUDEEP_HAIKU_MODEL:=deepseek-v4-flash-vision-exp}"
: "${CLAUDEEP_SUBAGENT_MODEL:=deepseek-v4-flash-vision-exp}"
: "${CLAUDEEP_SMALL_MODEL:=deepseek-v4-flash-vision-exp}"
: "${CLAUDEEP_MAX_CONTEXT_TOKENS:=1000000}"
: "${CLAUDEEP_AUTO_COMPACT_WINDOW:=786432}"
: "${CLAUDEEP_CLAUDE_BIN:=/opt/claude-code/bin/claude}"
: "${CLAUDEEP_API_KEY_FILE:=${XDG_CONFIG_HOME:-$HOME/.config}/claudeep/api-key}"

api_key="${CLAUDEEP_API_KEY:-${DEEPSEEK_API_KEY:-}}"
if [ -z "$api_key" ] && [ -r "$CLAUDEEP_API_KEY_FILE" ]; then
    api_key="$(<"$CLAUDEEP_API_KEY_FILE")"
fi

die() { printf 'claudeep: %s\n' "$*" >&2; exit 1; }

[ -n "$api_key" ] \
    || die "no DeepSeek API key — set CLAUDEEP_API_KEY, DEEPSEEK_API_KEY, or $CLAUDEEP_API_KEY_FILE."
[ -x "$CLAUDEEP_CLAUDE_BIN" ] \
    || die "claude binary not found at $CLAUDEEP_CLAUDE_BIN (set CLAUDEEP_CLAUDE_BIN)."

# Keep Claude Code's native picker, but bind each tier to a DeepSeek model
# explicitly: Fable and Opus to V4 Pro, Sonnet and Haiku to V4 Flash Vision.
# Left unset, the picker's own IDs go to DeepSeek's name heuristic, which
# resolves any name it doesn't recognise — claude-fable-5 included — to
# text-only V4 Flash. Flash and Pro reject images with 400; only
# deepseek-v4-flash-vision-exp accepts them. Vision matches Flash on text
# price and quality, so it is the Flash-tier default. Opus stays on Pro;
# set CLAUDEEP_OPUS_MODEL / CLAUDEEP_FABLE_MODEL to the vision id if those
# tiers should accept images too. Set CLAUDEEP_MODEL to pin one model
# outright and bypass the picker.
#
# All three V4 models are natively 1M-context and take the full window with
# no beta header and no [1m] suffix on the wire — measured at 294,741 input
# tokens on deepseek-v4-pro. A bare deepseek-v4-* ID matches no Claude
# pattern, though, so Claude Code would assume a smaller window and compact
# early. Because the ID neither starts with "claude-" nor carries a [1m]
# suffix, CLAUDE_CODE_MAX_CONTEXT_TOKENS applies directly and proactive
# compaction runs at the declared window.
#
# Keep the model names bare. DeepSeek does accept deepseek-v4-pro[1m] (it
# strips the suffix and serves Pro), but on Claude Code's side that suffix
# makes it assume 1M on its own and stops CLAUDE_CODE_MAX_CONTEXT_TOKENS from
# applying, so the window stops being adjustable from here.
model_env=()
[ -n "$CLAUDEEP_MODEL" ] && model_env+=("ANTHROPIC_MODEL=$CLAUDEEP_MODEL")

exec env -u ANTHROPIC_API_KEY \
    ANTHROPIC_BASE_URL="$CLAUDEEP_BASE_URL" \
    ANTHROPIC_AUTH_TOKEN="$api_key" \
    ANTHROPIC_DEFAULT_FABLE_MODEL="$CLAUDEEP_FABLE_MODEL" \
    ANTHROPIC_DEFAULT_OPUS_MODEL="$CLAUDEEP_OPUS_MODEL" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="$CLAUDEEP_SONNET_MODEL" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="$CLAUDEEP_HAIKU_MODEL" \
    CLAUDE_CODE_SUBAGENT_MODEL="$CLAUDEEP_SUBAGENT_MODEL" \
    ANTHROPIC_SMALL_FAST_MODEL="$CLAUDEEP_SMALL_MODEL" \
    CLAUDE_CODE_MAX_CONTEXT_TOKENS="$CLAUDEEP_MAX_CONTEXT_TOKENS" \
    CLAUDE_CODE_AUTO_COMPACT_WINDOW="$CLAUDEEP_AUTO_COMPACT_WINDOW" \
    "${model_env[@]}" \
    CLAUDE_CODE_ENABLE_AUTO_MODE=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1 \
    DISABLE_UPDATES=1 \
    DISABLE_INSTALLATION_CHECKS=1 \
    DISABLE_AUTOUPDATER=1 \
    "$CLAUDEEP_CLAUDE_BIN" "$@"
